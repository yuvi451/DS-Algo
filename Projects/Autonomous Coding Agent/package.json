{
  "name": "autonomous-coding-agent",
  "version": "0.1.0",
  "description": "A minimal, TypeScript-native agent that turns a natural-language coding prompt into real, working codebase edits, verified by its own test run.",
  "private": true,
  "type": "module",
  "bin": {
    "aca": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/agent.test.js"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
